# Brigado v2 Environment Configuration Example
# Copy this file to .env and update with your actual values

# ============================================================================
# SSH Configuration
# ============================================================================
SSH_HOST=your-server-hostname
BRIGADO_SERVER=your-server-name

# ============================================================================
# Remote Paths
# ============================================================================
# Comma-separated list of remote paths to fetch bot databases from
REMOTE_PATHS=hummingbot-api/bots/instances,hummingbot-api/bots/archived

# ============================================================================
# PostgreSQL Database Configuration
# ============================================================================
# PostgreSQL connection details for fetching token_states and other tables
POSTGRES_HOST=your-server-hostname
POSTGRES_PORT=5432
POSTGRES_DB=hummingbot_api
POSTGRES_USER=hbot
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_DOCKER_CONTAINER=hummingbot-postgres

# Tables to fetch from PostgreSQL (comma-separated)
POSTGRES_TABLES=token_states,account_states

# ============================================================================
# Local Data Paths
# ============================================================================
# These are automatically managed by FileManager, but can be overridden
# LOCAL_DATA_DIR=./data/brigado
# LOCAL_REPORTS_DIR=./reports
